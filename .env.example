# Copy this to .env (or set these as real environment variables on your host) before
# running the server. Never commit the real .env file.

# The secret the extension must send as the "x-operator-key" header on every call to
# /api/v1/liveness-tasks/operator/*. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPERATOR_API_KEY=

# The public HTTPS URL this server is reachable at (e.g. https://sweven-liveness.onrender.com).
# This becomes the "server" field baked into every task link, so the phone app knows
# where to call back — get it wrong and the phone app can't reach the server at all.
PUBLIC_BASE_URL=

# Where tasks are actually stored. A free Upstash Redis database (upstash.com) — its
# dashboard shows both of these under "REST API" after you create one. Required: with
# these unset, every task fails to save. See README.md for exact steps.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, defaults to 8787. Render and most hosts set this for you automatically.
PORT=8787
